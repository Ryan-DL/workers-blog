{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-part2",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // D1 holds only the dynamic data (view counts). Post content lives in
  // content/posts/*.md and is compiled into the Worker at build time.
  //
  // `database_id` is a placeholder until you run:
  //   wrangler d1 create blog-part2-db
  // then paste the returned id here. Local dev (`wrangler dev`) works without it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-part2-db",
      "database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE"
    }
  ],

  "vars": {
    "SITE_TITLE": "blog-part2",
    "SITE_DESCRIPTION": "A blog on Cloudflare Workers",
    "SITE_URL": "http://localhost:8787"
  }

  // Front end comes later. When you add static assets, uncomment:
  // "assets": { "directory": "./public", "binding": "ASSETS" }
}
