{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // No database. Every entry is compiled into the bundle from content/**/*.md
  // at build time, so the Worker holds no mutable state and serving a page is a
  // lookup rather than a query.

  // CSS, JS, and images. A request matching a file here is served directly;
  // everything else falls through to the Worker, which renders the HTML.
  "assets": {
    "directory": "./public"
  },

  // Out of the box the site is served from <name>.<subdomain>.workers.dev, so a
  // fresh clone deploys and is live without owning a domain.
  //
  // To put it on your own domain, add a `routes` entry with the zone already on
  // the same Cloudflare account — `wrangler deploy` fails rather than
  // registering one for you:
  //
  //   "routes": [{ "pattern": "example.com", "custom_domain": true }],
  //
  // `custom_domain: true` hands Cloudflare the whole hostname: it creates the
  // DNS record and issues the certificate, and every path goes to this Worker.
  // Adding `routes` also turns `workers_dev` off unless it is set explicitly,
  // which is the right default — a second origin serving the same pages would
  // compete with the real domain for canonical URLs. See the README.
  "workers_dev": true,

  // Per-pull-request preview URLs, uploaded by CI with `wrangler versions
  // upload`. It defaults to the value of `workers_dev`, so it is redundant
  // today — but it is set explicitly because adding a custom domain would flip
  // `workers_dev` off and silently disable previews with it.
  //
  // Previews live on *.workers.dev only; Cloudflare will not serve them from a
  // custom domain.
  "preview_urls": true

  // Site title, description, socials, and the rest live in blog.config.ts —
  // one file, typed, rather than split between here and the source. Absolute
  // URLs are derived from the incoming request, so there is no hostname to
  // remember to change before deploying, on workers.dev or your own domain.
}
