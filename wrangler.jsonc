{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // No database. Every entry is compiled into the bundle from content/**/*.md
  // at build time, so the Worker holds no mutable state and serving a page is a
  // lookup rather than a query.

  // CSS, JS, and images. A request matching a file here is served directly;
  // everything else falls through to the Worker, which renders the HTML.
  "assets": {
    "directory": "./public"
  },

  // The live domain. `custom_domain` makes Cloudflare own the whole hostname:
  // it creates the DNS record and the certificate, and every path goes to this
  // Worker. That's what we want — the site, the assets, and the API are one
  // Worker, so there is nothing else at this hostname to route around.
  //
  // The zone must already be on the same Cloudflare account; `wrangler deploy`
  // fails rather than creating one. Only the apex is claimed here — see the
  // README on adding www.
  "routes": [{ "pattern": "ryandelap.io", "custom_domain": true }]

  // Site title, description, socials, and the rest live in blog.config.ts —
  // one file, typed, rather than split between here and the source. Absolute
  // URLs are derived from the incoming request, so there is no hostname to
  // remember to change before deploying.
}
