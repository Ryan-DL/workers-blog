{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-part2",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // D1 holds only the dynamic data (view counts). Post content lives in
  // content/posts/*.md and is compiled into the Worker at build time.
  //
  // `database_id` is a placeholder until you run:
  //   wrangler d1 create blog-part2-db
  // then paste the returned id here. Local dev (`wrangler dev`) works without it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-part2-db",
      "database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE"
    }
  ],

  // CSS, JS, and images. A request matching a file here is served directly;
  // everything else falls through to the Worker, which renders the HTML.
  "assets": {
    "directory": "./public"
  }

  // Site title, description, socials, and the rest live in blog.config.ts —
  // one file, typed, rather than split between here and the source. Absolute
  // URLs are derived from the incoming request, so there is no hostname to
  // remember to change before deploying.
}
